{
  "name": "wd-front-core",
  "version": "3.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "vite build --config ./__vite__/vite.config.js --minify false",
    "clean": "rd /s /q build",
    "lint-fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "npx prettier \"src/**/*.{js,jsx,ts,tsx}\" --write",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*!(*test).(js|ts|jsx|tsx)": [
      "npm run lint"
    ]
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "7.26.10",
    "@babel/plugin-proposal-decorators": "7.25.9",
    "@babel/preset-env": "7.26.9",
    "@types/node": "20.12.12",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "@typescript-eslint/eslint-plugin": "7.2.0",
    "@typescript-eslint/parser": "7.2.0",
    "@vitejs/plugin-basic-ssl": "2.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "dotenv": "16.4.2",
    "esbuild-plugin-react-virtualized": "1.0.4",
    "eslint": "8.57.0",
    "eslint-plugin-react": "7.34.1",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-react-refresh": "0.4.6",
    "husky": "9.0.11",
    "lint-staged": "15.2.2",
    "nodemon": "2.0.22",
    "prettier": "3.2.5",
    "typescript": "5.1.6",
    "vite": "6.2.6",
    "vite-plugin-babel": "1.3.0",
    "vite-plugin-dts": "4.5.3",
    "vite-plugin-html": "3.2.2",
    "vite-plugin-svgr": "4.3.0"
  },
  "dependencies": {
    "@auth-strategy-manager/core": "^1.0.4",
    "axios": ">=1.5.1",
    "install": "^0.13.0",
    "keycloak-js": "^24.0.1",
    "mobx": ">=6.10.2",
    "npm": "^11.4.2",
    "query-string": "8.1.0"
  },
  "peerDependencies": {
    "mobx": ">=6.10.2"
  }
}
